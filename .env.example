# Puerto HTTP y Socket.IO (Render define PORT automáticamente).
PORT=3001

# Orígenes del frontend permitidos para Socket.IO, separados por coma.
CORS_ORIGINS=http://localhost:5173

# JSON completo de la cuenta de servicio Firebase, en una sola línea.
# No subir credenciales reales al repositorio.
FIREBASE_SERVICE_ACCOUNT_JSON=
